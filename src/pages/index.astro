---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
import { businessSchema, websiteSchema, webPageSchema } from '../lib/schema';

const title = 'The Loaded Scone Co. | Cornish Loaded Scones & Milkshakes, Falmouth';
const description =
  "Handcrafted loaded scones, signature sundaes and Cornish ice cream milkshakes. Eat in or take away in Falmouth, Cornwall. Order online and we'll post treats straight to your door.";

const base = Astro.site;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessSchema(base),
    websiteSchema(base),
    webPageSchema(base, {
      path: '/',
      name: title,
      description,
      primaryImage: '/images/social-share.jpg',
    }),
  ],
};
---

<Base title={title} description={description} current="home" schema={schema}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/logo-wordmark.webp"
    fetchpriority="high"
  />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <p class="eyebrow">Handcrafted in Cornwall</p>
        <h1>Indulgence, <span class="gold-script">Loaded.</span></h1>
        <p class="hero-sub">Fresh-baked loaded scones, signature sundaes &amp; thick Cornish ice cream milkshakes &mdash; eat in at St Georges Arcade or take away wherever you're headed.</p>
        <div class="hero-actions">
          <a href="#menu" class="btn btn-gold">View Our Menu</a>
          <a href={site.shopUrl} target="_blank" rel="noopener" class="btn btn-outline">Order Online</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/logo-wordmark.webp" alt="The Loaded Scone Co. logo" width="1091" height="650" fetchpriority="high">
      </div>
    </div>
  </section>

  <!-- ===== STATS STRIP ===== -->
  <section class="stats-strip">
    <div class="container stats-grid">
      <div class="stat"><span class="stat-num">5,000+</span><span class="stat-label">Happy Customers</span></div>
      <div class="stat"><span class="stat-num">50+</span><span class="stat-label">Topping Combinations</span></div>
      <div class="stat"><span class="stat-num">5</span><span class="stat-label">Years Handcrafting Scones</span></div>
      <div class="stat"><span class="stat-num">5★</span><span class="stat-label">Food Hygiene Rated</span></div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-image">
        <img src="/images/about-team.jpg" alt="The Loaded Scone Co. team outside the shop in Falmouth" width="335" height="472" loading="lazy" decoding="async">
      </div>
      <div class="about-text">
        <p class="eyebrow">Our Story</p>
        <h2>Loaded like a sandwich, packed with flavour.</h2>
        <p>The Loaded Scone Co. is a small independent scone shop handcrafted in Cornwall, tucked inside St Georges Arcade in the heart of Falmouth. We take the classic Cornish scone and turn it into something entirely our own &mdash; fully loaded, sweet or savoury, and always made fresh to order.</p>
        <p>Our savoury scones are built like a sandwich using our own oversized cheese scone, layered with local Cornish cheeses, chutneys, charcuterie and fresh salad. Our sweet scones come piled with Cornish clotted cream, premium fillings and generous toppings &mdash; because here, jam always goes first. Pair either with one of our thick milkshakes or a made-to-order sundae, built with award-winning Roskilly's Cornish ice cream.</p>
        <p>Everything is handmade in Cornwall, loaded with local ingredients, and loaded with love.</p>
        <div class="about-badges">
          <span class="badge">Handmade in Cornwall</span>
          <span class="badge">Vegan Options Available</span>
          <span class="badge">Gluten Free Available</span>
          <span class="badge">Eat In or Take Away</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PHOTO STRIP ===== -->
  <section class="photo-strip">
    <div class="container">
      <p class="eyebrow center">Fresh Out the Kitchen</p>
      <h2 class="section-title center">Loaded, Every Day</h2>
      <div class="photo-strip-grid">
        <div class="strip-item"><img src="/images/strip-1.jpg" alt="A loaded scone from The Loaded Scone Co." width="750" height="1000" loading="lazy" decoding="async"></div>
        <div class="strip-item"><img src="/images/strip-2.jpg" alt="A loaded scone from The Loaded Scone Co." width="750" height="1000" loading="lazy" decoding="async"></div>
        <div class="strip-item"><img src="/images/strip-3-milkshake.jpg" alt="A milkshake from The Loaded Scone Co." width="750" height="1000" loading="lazy" decoding="async"></div>
        <div class="strip-item"><img src="/images/strip-4.jpg" alt="A loaded scone from The Loaded Scone Co." width="750" height="1000" loading="lazy" decoding="async"></div>
      </div>
    </div>
  </section>

  <!-- ===== MENU PREVIEW (the full menu lives at /menu/) ===== -->
  <section class="menu-preview" id="menu">
    <div class="container">
      <p class="eyebrow center">Fresh, Loaded, Handmade Daily</p>
      <h2 class="section-title center">Our Menu</h2>
      <p class="menu-preview-intro">Sweet and savoury loaded scones, thick Roskilly&rsquo;s Cornish ice cream milkshakes, signature sundaes and banana splits &mdash; all made fresh to order in Falmouth.</p>
      <div class="menu-preview-grid">
        <a class="menu-preview-card" href="/menu/#sweet">
          <h3>Sweet Loaded Scones <span class="price-pill small">&pound;7.95</span></h3>
          <p>Ten signature scones piled with Cornish clotted cream, premium fillings and generous toppings. Jam first, always.</p>
          <span class="menu-preview-link">See all sweet scones &rarr;</span>
        </a>
        <a class="menu-preview-card" href="/menu/#savoury">
          <h3>Savoury Loaded Scones <span class="price-pill small">&pound;8.95</span></h3>
          <p>Built like a sandwich on our oversized cheese scone, with Cornish cheeses, chutneys and charcuterie. Build your own from &pound;7.95.</p>
          <span class="menu-preview-link">See all savoury scones &rarr;</span>
        </a>
        <a class="menu-preview-card" href="/menu/#milkshakes">
          <h3>Milkshakes <span class="price-pill small">from &pound;6.95</span></h3>
          <p>Twenty thick shakes made with award-winning Roskilly&rsquo;s Cornish ice cream &mdash; or build your own from four flavours.</p>
          <span class="menu-preview-link">See all milkshakes &rarr;</span>
        </a>
        <a class="menu-preview-card" href="/menu/#sundaes">
          <h3>Signature Sundaes <span class="price-pill small">&pound;6.95</span></h3>
          <p>Twelve made-to-order sundaes, from Biscoff Reserve to Pistachio Verde, built on Roskilly&rsquo;s Cornish ice cream.</p>
          <span class="menu-preview-link">See all sundaes &rarr;</span>
        </a>
        <a class="menu-preview-card" href="/menu/#banana-splits">
          <h3>Banana Splits <span class="price-pill small">&pound;6.95</span></h3>
          <p>Fresh banana, premium ice cream and loaded toppings &mdash; eight house splits plus build your own.</p>
          <span class="menu-preview-link">See all banana splits &rarr;</span>
        </a>
      </div>
      <div class="menu-preview-cta">
        <a href="/menu/" class="btn btn-gold">View the Full Menu</a>
        <a href={site.shopUrl} target="_blank" rel="noopener" class="btn btn-outline-light">Order Online</a>
      </div>
    </div>
  </section>

  <!-- ===== ICE CREAM ===== -->
  <section class="ice-cream" id="ice-cream">
    <div class="container ice-cream-grid">
      <div class="ice-cream-text">
        <p class="eyebrow">Local &amp; Cornish</p>
        <h2>Real Roskilly's Ice Cream</h2>
        <p>Alongside our loaded scones, milkshakes and sundaes, we serve award-winning Roskilly's ice cream by the scoop, right from the counter &mdash; made just up the coast using milk from their own herd.</p>
        <p>Grab a tub or cone on its own, or add a scoop to any loaded scone, milkshake or sundae for extra indulgence.</p>
        <div class="about-badges">
          <span class="badge">Locally Made</span>
          <span class="badge">Award-Winning</span>
          <span class="badge">By the Scoop</span>
        </div>
      </div>
      <div class="ice-cream-image">
        <img src="/images/roskillys-ice-cream.jpg" alt="Roskilly's Cornish ice cream counter at The Loaded Scone Co." width="1007" height="1200" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section class="gallery" id="gallery">
    <div class="container">
      <p class="eyebrow center">A Little Taste</p>
      <h2 class="section-title center">Our Shop in Falmouth</h2>
      <div class="gallery-grid">
        <div class="gallery-item large"><img src="/images/gallery-shopfront.jpg" alt="The Loaded Scone Co. shopfront in St Georges Arcade, Falmouth" data-lightbox width="1200" height="900" loading="lazy" decoding="async"></div>
        <div class="gallery-item"><img src="/images/gallery-entrance.jpg" alt="The Loaded Scone Co. entrance with ice cream counter" data-lightbox width="681" height="900" loading="lazy" decoding="async"></div>
        <div class="gallery-item"><img src="/images/gallery-counter.jpg" alt="Inside The Loaded Scone Co. serving counter" data-lightbox width="1200" height="900" loading="lazy" decoding="async"></div>
        <div class="gallery-item"><img src="/images/gallery-scone-1.jpg" alt="A loaded scone from The Loaded Scone Co." data-lightbox width="750" height="1000" loading="lazy" decoding="async"></div>
        <div class="gallery-item"><img src="/images/gallery-scone-2.jpg" alt="A loaded scone from The Loaded Scone Co." data-lightbox width="1000" height="750" loading="lazy" decoding="async"></div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S ON (SEASONAL — SWAP THE .season-card BLOCK BELOW EACH SEASON) ===== -->
  <section class="whats-on" id="whats-on">
    <div class="container">
      <p class="eyebrow center">What's On</p>
      <h2 class="section-title center">What's On Down at the Arcade</h2>
      <p class="whats-on-intro">A proper Cornish "What's On" &mdash; our round-up of what's happening in store, updated with the seasons. Nothing on right now, but watch this space.</p>

      <!-- SEASONAL CARD START — Halloween teaser. Replace or update this .season-card block as the season approaches / for the next season. -->
      <div class="season-reveal" id="season-reveal">
        <button type="button" class="season-reveal-btn" id="season-reveal-btn">
          <span class="season-reveal-icon">👻</span>
          <span>Tap here to see what's coming</span>
        </button>
        <div class="season-card season-halloween">
          <div class="season-icon-row">
            <span>🎃</span><span>👻</span><span>🦇</span><span>🧙</span><span>🕸️</span>
          </div>
          <p class="season-eyebrow">Coming Soon &middot; October</p>
          <h3>Spooky Season Is On Its Way</h3>
          <p>Watch this space &mdash; things get a little loaded and a lot more haunted once October rolls around, with the team dressed up as zombies, witches and all sorts of Halloween favourites behind the counter, plus seasonal specials while they last. Details to follow closer to the time.</p>
          <div class="season-badges">
            <span class="season-badge">🎃 Staff in Fancy Dress</span>
            <span class="season-badge">👻 Seasonal Specials</span>
            <span class="season-badge">🍬 Family Friendly</span>
          </div>
          <p class="sound-credit" id="sound-credit">Sound Effect by <a href="https://pixabay.com/users/freesound_community-46691455/?utm_source=link-attribution&amp;utm_medium=referral&amp;utm_campaign=music&amp;utm_content=95203" target="_blank" rel="noopener">freesound_community</a> from <a href="https://pixabay.com/sound-effects//?utm_source=link-attribution&amp;utm_medium=referral&amp;utm_campaign=music&amp;utm_content=95203" target="_blank" rel="noopener">Pixabay</a></p>
        </div>
      </div>
      <audio id="witch-laugh-audio" src="/audio/witch-laugh.mp3" preload="none"></audio>
      <!-- SEASONAL CARD END -->

    </div>
  </section>

  <!-- ===== FIND US / CONTACT ===== -->
  <section class="find-us" id="find-us">
    <div class="container find-us-grid">
      <div class="find-us-info">
        <p class="eyebrow">Visit Us</p>
        <h2>Find &amp; Contact Us</h2>
        <div class="info-block">
          <h4>📍 Address</h4>
          <p>1 St Georges Arcade<br>Falmouth, Cornwall<br>TR11 3DH</p>
        </div>
        <div class="info-block">
          <h4>✉️ Email</h4>
          <p><a href="mailto:Treatme@theloadedsconeco.co.uk">Treatme@theloadedsconeco.co.uk</a></p>
        </div>
        <div class="info-block">
          <h4>📞 Phone</h4>
          <p>01326 &mdash; call in store for the full number, or drop us an email above.</p>
        </div>
        <div class="info-block">
          <h4>🍦 Eat In or Take Away</h4>
          <p>Pop in for a seat right outside the shop in the arcade, or grab your loaded scone or milkshake to go.</p>
        </div>
        <div class="info-block">
          <h4>📦 Posted to Your Door</h4>
          <p>Can't make it to Falmouth? Order a postal Cornish cream tea or scone box online and we'll post it straight to your door &mdash; not a takeaway courier, a parcel through your letterbox.</p>
        </div>
        <a href={site.shopUrl} target="_blank" rel="noopener" class="btn btn-gold">Order Online for Postal Delivery</a>
      </div>
      <div class="find-us-map">
        <iframe
          title="Map to The Loaded Scone Co, 1 St Georges Arcade, Falmouth"
          src="https://www.google.com/maps?q=1+St+Georges+Arcade,+Falmouth,+Cornwall+TR11+3DH&output=embed"
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <CtaBand />

  <Fragment slot="after">
    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close full size photo">&times;</button>
      <img id="lightbox-img" src="" alt="">
    </div>
  </Fragment>
</Base>
